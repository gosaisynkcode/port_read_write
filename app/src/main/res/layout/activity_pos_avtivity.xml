<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".POS_Avtivity">

    <!-- Header Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:text="Connect"
            android:textSize="@dimen/_8sdp"
            tools:ignore="ButtonStyle,HardcodedText,TextSizeCheck,VisualLintButtonSize" />

        <Button
            android:id="@+id/btnReadUid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Read UID"
            android:textSize="@dimen/_8sdp"
            tools:ignore="ButtonStyle,HardcodedText,TextSizeCheck,VisualLintButtonSize" />

        <Button
            android:id="@+id/btnReadMifare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Read Block"
            android:textSize="@dimen/_8sdp"
            tools:ignore="ButtonStyle,HardcodedText,TextSizeCheck,VisualLintButtonSize" />

        <Button
            android:id="@+id/btnClearLogs"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Clear Logs"
            android:textSize="12sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <!-- Card Data Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#2B6CB0"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvReaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_5sdp"
                android:text="POS: Disconnected"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_7sdp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,TextSizeCheck" />

            <TextView
                android:id="@+id/tvCardUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="CARD UID: --"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_15sdp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,TextSizeCheck" />

            <TextView
                android:id="@+id/tvCardAtr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="ATR / ATS: --"
                android:textColor="#E2E8F0"
                android:textSize="@dimen/_8sdp"
                tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck" />

            <TextView
                android:id="@+id/tvCardType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Type: Waiting for card scan..."
                android:textColor="#CBD5E0"
                android:textSize="@dimen/_8sdp"
                tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Scrollable Log Output Box -->
    <ScrollView
        android:id="@+id/scrollViewLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_8sdp" />
    </ScrollView>

</LinearLayout>
