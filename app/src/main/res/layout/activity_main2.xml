<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_5sdp"
    tools:context=".MainActivity">
<LinearLayout
    android:id="@+id/lv_layout"
    android:layout_margin="@dimen/_5sdp"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="MissingConstraints">
    <Button
        android:layout_weight="1"
        android:id="@+id/bt_allow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allow"
        android:padding="@dimen/_5sdp"
        android:textSize="@dimen/_10sdp"
        android:textStyle="bold"
        tools:ignore="ButtonStyle,HardcodedText,MissingConstraints,TextSizeCheck,TouchTargetSizeCheck,VisualLintButtonSize,VisualLintSystemUi"
        tools:layout_editor_absoluteX="9dp"
        tools:layout_editor_absoluteY="16dp" />
    <Button
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_weight="1"
        android:id="@+id/bt_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:textSize="@dimen/_10sdp"
        android:padding="@dimen/_5sdp"
        android:textStyle="bold"
        tools:ignore="ButtonStyle,HardcodedText,MissingConstraints,TextSizeCheck,TouchTargetSizeCheck,VisualLintButtonSize,VisualLintSystemUi"
        tools:layout_editor_absoluteX="9dp"
        tools:layout_editor_absoluteY="16dp" />
</LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F0F0"
        android:padding="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@+id/lv_layout"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="6dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Initializing..."
            android:textSize="@dimen/_10sdp"
            tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck,VisualLintSystemUi" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>