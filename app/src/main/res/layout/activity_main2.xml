<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_5sdp"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/bt_allow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:text="Allow"
        android:textSize="@dimen/_10sdp"
        android:textStyle="bold"
        tools:ignore="HardcodedText,MissingConstraints,VisualLintButtonSize,VisualLintSystemUi,TextSizeCheck,TouchTargetSizeCheck"
        tools:layout_editor_absoluteX="6dp"
        tools:layout_editor_absoluteY="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F0F0F0"
        android:padding="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@+id/bt_allow"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="6dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Initializing..."
            android:textSize="@dimen/_10sdp"
            tools:ignore="HardcodedText,TextSizeCheck,TextContrastCheck,VisualLintSystemUi" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>